# Kinetix IDE: Environment Parameter Configurations Override
# Copy this file to your root '.env' file and supply project variables

# Web Console Port (default: 3000)
PORT=3000

# Ollama API Gateway Target (e.g. 127.0.0.1:11434, 0.0.0.0:11434)
OLLAMA_HOST=127.0.0.1:11434

# GCP Nexus telemetry integration parameters
GCP_PROJECT_ID=your-gcp-project-id
SENTINEL_BIGQUERY_DATASET=sentinel_telemetry
SENTINEL_BIGQUERY_TABLE=node_health_log

# Process variables overrides
ACTIVE_BILLING_TARGET=your-inference-target
